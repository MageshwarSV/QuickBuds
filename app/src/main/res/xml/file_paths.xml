<?xml version="1.0" encoding="utf-8"?>
<!--
  Paths exposed by the FileProvider.

  Only the cache directory is exposed, for two flows: the downloaded update APK
  (UpdateActivity.APK_NAME), handed to the package installer, and the Disconnect
  locations CSV export (cache/exports), handed to the share sheet. Each URI is
  granted for one file only. Nothing else in the app's storage is reachable.

  Do not widen this to external storage: the widget and logs use their own paths,
  and a broader file_paths.xml would let any app that is handed a granted URI
  read more than the update file.
-->
<paths>
    <cache-path
        name="updates"
        path="." />
</paths>
