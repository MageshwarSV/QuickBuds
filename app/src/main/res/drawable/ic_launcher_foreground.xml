<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher foreground: the Loop logo, a white slanted L and a red angled stroke, traced from the
  1254 x 1254 logo artwork (ink bounds x 208-1058, y 322-936). The group centres it and scales it 0.78, so the
  farthest corner stays 31 units from the centre, inside the 33-unit safe circle. The themed-icon layer is
  ic_launcher_monochrome.xml. On the black ic_launcher_background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1254"
    android:viewportHeight="1254">
    <group
        android:pivotX="633"
        android:pivotY="629"
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:translateX="-6"
        android:translateY="-2">
        <path android:pathData="M574,322 L778,322 L494,698 L788,698 L698,812 L208,812 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="560"
                    android:startY="330"
                    android:endX="560"
                    android:endY="812"
                    android:startColor="#FFFFFFFF"
                    android:endColor="#FFE2E2E6" />
            </aapt:attr>
        </path>
        <path android:pathData="M716,500 L958,500 Q976,500 986,514 L1050,610 Q1062,628 1050,645 L918,822 Q908,834 894,840 L668,936 L908,640 L884,602 L636,602 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="980"
                    android:startY="500"
                    android:endX="700"
                    android:endY="930"
                    android:startColor="#FFFF0A16"
                    android:endColor="#FFD6000C" />
            </aapt:attr>
        </path>
    </group>
</vector>
