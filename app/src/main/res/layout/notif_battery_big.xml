<?xml version="1.0" encoding="utf-8"?>
<!-- Battery card, expanded (BatteryCard): the buds' name, then a big ring for left, case, right (the parts shown), its level under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/b_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout android:id="@+id/b_l" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/b_l_ring" android:layout_width="72dp" android:layout_height="72dp"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/b_l_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
        </LinearLayout>

        <LinearLayout android:id="@+id/b_c" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/b_c_ring" android:layout_width="72dp" android:layout_height="72dp"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/b_c_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
        </LinearLayout>

        <LinearLayout android:id="@+id/b_r" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/b_r_ring" android:layout_width="72dp" android:layout_height="72dp"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/b_r_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
